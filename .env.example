# Codex Relay 配置
# 复制此文件为 .env 并修改

# 服务端口
PORT=3000

# 管理后台密钥 (首次启动时必须设置)
ADMIN_KEY=change-me-to-a-strong-secret

# 数据库路径
DATABASE_URL=data/codex_relay.db

# 代理 (本机代理端口)
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897

# 默认上游 (首次启动时自动创建)
DEFAULT_UPSTREAM_BASE_URL=https://api.openai.com/v1
DEFAULT_UPSTREAM_API_KEY=sk-your-openai-key

# 日志级别
LOG_LEVEL=INFO
